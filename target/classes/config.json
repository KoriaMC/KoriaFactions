{
  "mondes-desactives": [],
  "debug": false,
  "stockage": {
    "type": "JSON",
    "sauvegarde-auto-minutes": 5,
    "copies-de-securite": 3,
    "json-indente": true,
    "sqlite-fichier": "database.db",
    "mysql": {
      "hote": "localhost",
      "port": 3306,
      "base": "koriafactions",
      "utilisateur": "root",
      "mot-de-passe": "",
      "prefixe-tables": "kf_",
      "parametres": "?useSSL=false&autoReconnect=true&useUnicode=true&characterEncoding=utf8"
    }
  },
  "commande": {
    "nom": "f",
    "alias": ["faction", "factions", "fac"],
    "description": "Commandes de faction",
    "sans-argument": "AIDE",
    "aide-par-page": 8,
    "aide-cliquable": true
  },
  "commandes": {
    "help": { "actif": true, "alias": ["?"], "delai": 0, "permission": "koriafactions.command.help" },
    "menu": { "actif": true, "alias": ["gui", "m"], "delai": 0, "permission": "koriafactions.command.menu" },
    "create": { "actif": true, "alias": ["make"], "delai": 3, "permission": "koriafactions.command.create" },
