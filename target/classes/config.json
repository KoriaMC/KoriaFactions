    "show": { "actif": true, "alias": ["who", "info", "i"], "delai": 1, "permission": "koriafactions.command.show" },
    "list": { "actif": true, "alias": ["ls"], "delai": 1, "permission": "koriafactions.command.list" },
    "map": { "actif": true, "alias": [], "delai": 1, "permission": "koriafactions.command.map" },
    "claim": { "actif": true, "alias": ["cl"], "delai": 0, "permission": "koriafactions.command.claim" },
