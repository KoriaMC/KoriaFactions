    "autoclaim": { "actif": true, "alias": ["aclaim"], "delai": 0, "permission": "koriafactions.command.autoclaim" },
    "autounclaim": { "actif": true, "alias": ["aunclaim"], "delai": 0, "permission": "koriafactions.command.autounclaim" },
    "invite": { "actif": true, "alias": ["inv"], "delai": 0, "permission": "koriafactions.command.invite" },
    "deinvite": { "actif": true, "alias": ["uninvite"], "delai": 0, "permission": "koriafactions.command.deinvite" },
    "invites": { "actif": true, "alias": ["invitations"], "delai": 0, "permission": "koriafactions.command.invites" },
    "join": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.join" },
    "leave": { "actif": true, "alias": ["quit"], "delai": 0, "permission": "koriafactions.command.leave" },
    "kick": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.kick" },
    "ban": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.ban" },
    "unban": { "actif": true, "alias": ["pardon"], "delai": 0, "permission": "koriafactions.command.unban" },
    "banlist": { "actif": true, "alias": ["bans"], "delai": 0, "permission": "koriafactions.command.banlist" },
    "promote": { "actif": true, "alias": ["up"], "delai": 0, "permission": "koriafactions.command.promote" },
    "demote": { "actif": true, "alias": ["down"], "delai": 0, "permission": "koriafactions.command.demote" },
    "leader": { "actif": true, "alias": ["owner"], "delai": 0, "permission": "koriafactions.command.leader" },
    "title": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.title" },
    "home": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.home" },
    "sethome": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.sethome" },
    "delhome": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.delhome" },
    "warp": { "actif": true, "alias": ["w"], "delai": 0, "permission": "koriafactions.command.warp" },
    "setwarp": { "actif": true, "alias": ["sw", "createwarp"], "delai": 0, "permission": "koriafactions.command.setwarp" },
    "delwarp": { "actif": true, "alias": ["dw", "deletewarp"], "delai": 0, "permission": "koriafactions.command.delwarp" },
    "warps": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.warp" },
    "chat": { "actif": true, "alias": ["c", "ch", "channel"], "delai": 0, "permission": "koriafactions.command.chat" },
    "chest": { "actif": true, "alias": ["pv", "vault"], "delai": 0, "permission": "koriafactions.command.chest" },
    "seechunk": { "actif": true, "alias": ["sc", "border"], "delai": 0, "permission": "koriafactions.command.seechunk" },
    "top": { "actif": true, "alias": ["leaderboard"], "delai": 2, "permission": "koriafactions.command.top" },
    "quests": { "actif": true, "alias": ["q"], "delai": 0, "permission": "koriafactions.command.quests", "commande": "quests faction" },
    "power": { "actif": true, "alias": ["pow", "p"], "delai": 0, "permission": "koriafactions.command.power" },
    "perms": { "actif": true, "alias": ["permissions", "perm"], "delai": 0, "permission": "koriafactions.command.perms" },
    "flags": { "actif": true, "alias": ["flag", "settings"], "delai": 0, "permission": "koriafactions.command.flags" },
    "open": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.open" },
    "access": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.access" },
    "upgrades": {
      "actif": true,
      "alias": ["upgrade", "ameliorations"],
      "delai": 0,
      "permission": "koriafactions.command.upgrades"
    },
    "logs": { "actif": true, "alias": ["log"], "delai": 0, "permission": "koriafactions.command.logs" },
    "announce": { "actif": true, "alias": [], "delai": 30, "permission": "koriafactions.command.announce" },
    "coords": { "actif": true, "alias": ["position", "pos"], "delai": 5, "permission": "koriafactions.command.coords" },
    "toggle": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.command.toggle" },
    "version": { "actif": true, "alias": ["ver", "about"], "delai": 0, "permission": "koriafactions.command.version" },
    "bypass": { "actif": true, "alias": ["admin"], "delai": 0, "permission": "koriafactions.admin.bypass" },
