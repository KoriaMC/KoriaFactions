    "addpower": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.power" },
    "setpoints": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.points" },
    "addpoints": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.points" },
    "forcejoin": { "actif": true, "alias": ["fjoin"], "delai": 0, "permission": "koriafactions.admin.forcejoin" },
    "forcekick": { "actif": true, "alias": ["fkick"], "delai": 0, "permission": "koriafactions.admin.forcekick" },
    "setleader": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.setleader" },
    "setflag": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.setflag" },
    "setupgrade": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.setupgrade" },
    "config": { "actif": true, "alias": ["configuration", "cfg"], "delai": 0, "permission": "koriafactions.admin.config" },
    "save": { "actif": true, "alias": [], "delai": 0, "permission": "koriafactions.admin.save" },
    "reload": { "actif": true, "alias": ["rl"], "delai": 0, "permission": "koriafactions.admin.reload" }
  },
  "economie": {
    "actif": true,
    "format": "{amount} $",
    "decimales": 0,
    "couts": {
      "create": 5000,
      "rename": 2500,
      "sethome": 0,
      "home": 0,
      "setwarp": 500,
      "warp": 0,
      "invite": 0,
      "join": 0,
      "leave": 0,
      "description": 0,
      "motd": 0,
      "title": 0,
      "announce": 0,
      "map": 0,
      "show": 0,
      "list": 0
    },
    "recompense-kill": 0,
    "penalite-mort": 0
  },
  "chat": {
    "actif": true,
    "priorite": "HIGHEST",
    "mode-public": "FORMAT",
    "format-public": "{tag}{rank_prefix}{rank_color}{player}&7: &f{message}",
    "placeholder": "{FACTION}",
    "tag": "&7[{relation_color}{role_prefix}{faction}&7] ",
    "tag-sans-faction": "",
    "couleur-tag-par-defaut": "&e",
    "couleur-par-destinataire": false,
    "grades": {
      "empereur": { "permission": "koriafactions.rank.empereur", "nom": "Empereur", "couleur": "&6", "prefixe": "" },
      "conquerant": { "permission": "koriafactions.rank.conquerant", "nom": "Conquérant", "couleur": "&5", "prefixe": "" },
      "eclaireur": { "permission": "koriafactions.rank.eclaireur", "nom": "Éclaireur", "couleur": "&b", "prefixe": "" }
    },
    "sans-grade": { "nom": "Joueur", "couleur": "&7", "prefixe": "" },
    "canaux": {
      "FACTION": "&a[F] &7{role_prefix}{title}{rank_color}{player}&7: &a{message}",
      "MOD": "&e[Mod] &7{role_prefix}{rank_color}{player}&7: &e{message}"
    },
    "noms-des-canaux": {
      "PUBLIC": ["p", "public", "global", "g"],
      "FACTION": ["f", "faction", "fac"],
      "MOD": ["m", "mod", "officer"]
    },
    "role-min-canal-mod": "OFFICER",
    "format-espion": "&8[Espion] &7{message}",
    "canaux-dans-la-console": true,
    "prefixes-rapides": { "FACTION": "", "MOD": "" }
  },
  "classement": {
    "par-page": 10,
    "cache-secondes": 30,
    "categories": ["POWER", "CLAIMS", "MEMBERS", "POINTS"],
    "par-defaut": "POWER"
  },
  "journal": { "actif": true, "entrees-max": 150, "par-page": 10, "format-date": "dd/MM HH:mm" },
  "annonces": { "longueur-max": 120, "en-titre": true },
  "sons": {
    "invitation-recue": "NOTE_PLING",
    "claim": "ORB_PICKUP",
    "unclaim": "ITEM_BREAK",
    "clic-menu": "CLICK",
    "amelioration": "LEVEL_UP",
    "raidable": "WITHER_SPAWN"
  }
}
