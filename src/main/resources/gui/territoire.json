      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FFF05252",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_territoire_enemy% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_wilderness",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FF94A3B8",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_territoire_wilderness% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_safezone",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
