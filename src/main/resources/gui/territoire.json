      "color": "#00000000",
      "backgroundColor": "#14FFFFFF",
      "radius": 1,
      "text": ""
    },
    {
      "type": "PROGRESS",
      "id": "temps_own",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FF4ADE80",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_territoire_own% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_enemy",
      "x": 8,
      "y": 37,
