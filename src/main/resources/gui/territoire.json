      "max": "%local_notif_duree%",
      "color": "#FFFBBF24",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_territoire_safezone% == true"
    },
    {
      "type": "PROGRESS",
      "id": "temps_warzone",
      "x": 8,
      "y": 37,
      "width": 168,
      "height": 2,
      "shape": "BAR",
      "value": "%local_notif_restant%",
      "max": "%local_notif_duree%",
      "color": "#FFF97316",
      "backgroundColor": "#00000000",
      "radius": 1,
      "text": "",
      "condition": "%var_territoire_warzone% == true"
