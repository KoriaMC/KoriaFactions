{
  "type": "HUD",
  "note": "Toast d'entrée / sortie de territoire (plugin KoriaFactions). Variables : %var_territoire_categorie%, %var_territoire_titre%, %var_territoire_sous_titre%, %var_territoire_a_sous_titre%, %var_territoire_icone%, %var_territoire_type% et %var_territoire_<own|enemy|wilderness|safezone|warzone>% (true / false). Barre de temps : %local_notif_restant% / %local_notif_duree%.",
  "width": 184,
  "height": 42,
  "anchor": "TOP_RIGHT",
  "offsetX": -8,
  "offsetY": 8,
  "scaleMode": "ADAPT",
  "referenceWidth": 480,
  "referenceHeight": 270,
  "openAnimation": "SLIDE_LEFT",
  "animationDuration": 300,
  "easing": "EASE_OUT",
  "notifyDuration": 3500,
  "fadeOut": 450,
  "playerMovable": true,
  "refreshTicks": 10,
  "elements": [
    {
      "type": "RECT",
      "id": "ombre",
      "x": 1,
      "y": 2,
      "width": 184,
      "height": 42,
      "color": "#46000000",
      "radius": 8
    },
    {
      "type": "RECT",
      "id": "fond",
      "x": 0,
      "y": 0,
      "width": 184,
      "height": 42,
      "color": "#F4141820",
      "gradient": "#F40E1117",
      "radius": 8,
      "borderColor": "#16FFFFFF",
      "borderWidth": 1
    },
    {
      "type": "RECT",
      "id": "tuile_own",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#264ADE80",
      "radius": 7,
      "borderColor": "#504ADE80",
      "borderWidth": 1,
      "condition": "%var_territoire_own% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_enemy",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#26F05252",
      "radius": 7,
      "borderColor": "#50F05252",
      "borderWidth": 1,
      "condition": "%var_territoire_enemy% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_wilderness",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#2694A3B8",
      "radius": 7,
      "borderColor": "#5094A3B8",
      "borderWidth": 1,
      "condition": "%var_territoire_wilderness% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_safezone",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#26FBBF24",
      "radius": 7,
      "borderColor": "#50FBBF24",
      "borderWidth": 1,
      "condition": "%var_territoire_safezone% == true"
    },
    {
      "type": "RECT",
      "id": "tuile_warzone",
      "x": 8,
      "y": 8,
      "width": 26,
      "height": 26,
      "color": "#26F97316",
      "radius": 7,
      "borderColor": "#50F97316",
      "borderWidth": 1,
      "condition": "%var_territoire_warzone% == true"
    },
    {
      "type": "ITEM",
      "id": "icone",
      "x": 13,
      "y": 13,
      "width": 16,
      "height": 16,
      "item": "%var_territoire_icone%"
    },
    {
      "type": "TEXT",
      "id": "categorie",
      "x": 42,
      "y": 7,
      "width": 134,
      "height": 10,
      "scale": 0.58,
      "shadow": false,
      "text": "%var_territoire_categorie%",
      "condition": "%var_territoire_a_sous_titre% == true"
    },
    {
      "type": "TEXT",
      "id": "titre",
      "x": 42,
      "y": 16,
      "width": 134,
      "height": 10,
      "scale": 0.95,
      "shadow": false,
      "text": "%var_territoire_titre%",
      "condition": "%var_territoire_a_sous_titre% == true"
    },
    {
      "type": "TEXT",
      "id": "sous_titre",
      "x": 42,
      "y": 27,
      "width": 134,
      "height": 10,
      "scale": 0.66,
      "shadow": false,
      "text": "%var_territoire_sous_titre%",
      "condition": "%var_territoire_a_sous_titre% == true"
    },
    {
      "type": "TEXT",
      "id": "categorie_seule",
      "x": 42,
      "y": 11,
      "width": 134,
      "height": 10,
      "scale": 0.58,
